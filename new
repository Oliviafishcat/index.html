/* This targets the entire page */
body {
    background-color: #f0f4f8; /* A light blue-grey background */
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    margin: 0;
}

/* This styles your main heading */
h1 {
    color: #2c3e50;
    font-size: 3rem;
    border-bottom: 2px solid #3498db;
    padding-bottom: 10px;
}

/* This styles the paragraph */
p {
    color: #555;
    font-size: 1.2rem;
}
